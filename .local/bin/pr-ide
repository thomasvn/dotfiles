#!/usr/bin/env bash
# Open a GitHub PR in an IDE (Kiro by default) for review, checked out the way the
# GitHub Pull Requests extension expects, so its panel shows the PR and its full diff.
#
#   pr-ide https://github.com/kubecost/kubecost-cost-model/pull/5248
#   pr-ide kubecost/kubecost-cost-model#5248 Cursor
#   pr-ide kubecost/kubecost-cost-model#5248 "Visual Studio Code"
#
# Creates (or refreshes) a worktree next to your local clone, named
# <repo>-pr-<n>, on a local branch pr/<n>. Your clone's own checkout is never touched.
set -euo pipefail

CODE_ROOT="${PR_IDE_CODE_ROOT:-$HOME/code}"

[[ $# -eq 1 || $# -eq 2 ]] || { echo "usage: pr-ide <PR url | owner/repo#n> [macOS app name, default Kiro]" >&2; exit 2; }
app=${2:-Kiro}
open -Ra "$app" 2>/dev/null || { echo "pr-ide: no app named '$app' (try Kiro, Cursor, \"Visual Studio Code\")" >&2; exit 2; }
if [[ $1 =~ github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]] || [[ $1 =~ ^([^/]+)/([^#]+)#([0-9]+)$ ]]; then
  owner=${BASH_REMATCH[1]} repo=${BASH_REMATCH[2]} n=${BASH_REMATCH[3]}
else
  echo "pr-ide: can't parse '$1'; expected a PR URL or owner/repo#n" >&2; exit 2
fi

# Find the clone whose origin points at this repo. Prefer an exact owner match;
# fall back to a fork (e.g. thomasvn/opencost for opencost/opencost).
clone="" fork=""
while IFS= read -r gitdir; do
  dir=${gitdir%/.git}
  url=$(git -C "$dir" remote get-url origin 2>/dev/null || true)
  [[ $url =~ [:/]([^/:]+)/$repo(\.git)?$ ]] || continue
  if [[ ${BASH_REMATCH[1]} == "$owner" ]]; then clone=$dir; break; fi
  fork=${fork:-$dir}
done < <(find "$CODE_ROOT" -maxdepth 3 -name .git -type d 2>/dev/null)
clone=${clone:-$fork}
[[ -n $clone ]] || { echo "pr-ide: no clone of $owner/$repo under $CODE_ROOT (set PR_IDE_CODE_ROOT)" >&2; exit 1; }

# The extension finds the PR through a remote that points at the base repo
# (origin in a normal clone, upstream in a fork clone).
remote=$(git -C "$clone" remote -v | awk -v r="[:/]$owner/$repo(\\.git)?\$" '$2 ~ r {print $1; exit}')
[[ -n $remote ]] || { echo "pr-ide: $clone has no remote for $owner/$repo; add one, e.g. git -C $clone remote add upstream git@github.com:$owner/$repo.git" >&2; exit 1; }

read -r head_ref head_owner < <(gh pr view "$n" -R "$owner/$repo" --json headRefName,headRepositoryOwner --jq '"\(.headRefName) \(.headRepositoryOwner.login)"') \
  || { echo "pr-ide: gh pr view $owner/$repo#$n failed (see above)" >&2; exit 1; }
branch="pr/$n"
echo "clone:  $clone (remote $remote)"
echo "PR:     $owner/$repo#$n (head $head_owner:$head_ref)"

git -C "$clone" fetch --quiet "$remote" "refs/pull/$n/head"
head=$(git -C "$clone" rev-parse FETCH_HEAD)
# Head of our last checkout: a pr/<n> still on it has no local commits, even after a force-push.
old=$(git -C "$clone" rev-parse -q --verify "refs/pr-ide/$n/head" || echo "$head")

# Never throw away review edits or local commits on the PR branch.
wt="$(dirname "$clone")/$repo-pr-$n"
if [[ -d $wt && -n $(git -C "$wt" status --porcelain --untracked-files=no) ]]; then
  echo "pr-ide: $wt has uncommitted edits; commit, stash or discard them first" >&2; exit 1
fi
if git -C "$clone" rev-parse -q --verify "refs/heads/$branch" >/dev/null && ! git -C "$clone" merge-base --is-ancestor "$branch" "$head" \
  && ! git -C "$clone" merge-base --is-ancestor "$branch" "$old"; then
  echo "pr-ide: $branch has commits that aren't on the PR; push or move them first" >&2; exit 1
fi

if [[ -d $wt ]]; then
  git -C "$wt" checkout --quiet --force -B "$branch" "$head"
else
  git -C "$clone" worktree prune # forget a worktree whose folder was deleted by hand
  git -C "$clone" worktree add --quiet -B "$branch" "$wt" "$head"
fi
git -C "$clone" update-ref "refs/pr-ide/$n/head" "$head"

# Link the branch to the PR the same way the extension's own "Checkout" does.
git -C "$clone" config --replace-all "branch.$branch.github-pr-owner-number" "$owner#$repo#$n"
if [[ $head_owner == "$owner" ]]; then
  git -C "$clone" fetch --quiet "$remote" "+refs/heads/$head_ref:refs/remotes/$remote/$head_ref"
  git -C "$wt" branch --quiet --set-upstream-to "$remote/$head_ref" "$branch"
fi

echo "head:   ${head:0:9} on $branch"
echo "path:   $wt"
# `open -a` instead of the `kiro` CLI: when run from Kiro Crew, the CLI opened
# Kiro's home screen without the folder (2026-11-23).
open -a "$app" "$wt"
